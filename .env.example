# Aztec mainnet only. The public node has a safe default.
AZTEC_NODE_URL=https://aztec-mainnet.drpc.org

# Required. Use an Ethereum mainnet JSON-RPC endpoint.
ETHEREUM_RPC_URL=

# Generated by `pnpm accounts:generate`; never commit these values.
ETHEREUM_PRIVATE_KEY=
AZTEC_SECRET_KEY=
AZTEC_SIGNING_KEY=
AZTEC_ACCOUNT_SALT=
AZTEC_ACCOUNT_ADDRESS=
